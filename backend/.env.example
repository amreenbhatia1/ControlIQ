# development | test | production. In production the API refuses to start with a placeholder
# SECRET_KEY or with COOKIE_SECURE=false.
ENVIRONMENT=development

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://controliq:controliq@localhost:5432/controliq

# Used by the pytest suite. Tests create and drop schema objects in this database.
TEST_DATABASE_URL=postgresql+psycopg://controliq:controliq@localhost:5432/controliq_test

# REQUIRED outside local development: long random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-value

# Session cookie settings. Set COOKIE_SECURE=true when served over HTTPS.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Evidence storage (relative paths resolve from the backend directory)
EVIDENCE_STORAGE_DIR=storage/evidence
EVIDENCE_MAX_BYTES=2097152

# Password assigned to all synthetic demo users by the seed script
DEMO_PASSWORD=ControlIQ-Demo-2026!

# Optional: enables AI-generated (grounded) answers. Without it the assistant uses rule-based intelligence.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
